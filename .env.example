# Copy these into Vercel → Project → Settings → Environment Variables

# Admin panel password (shared by everyone who manages the shop)
ADMIN_PASSWORD=choose-a-strong-password

# Long random text used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Added automatically when you connect a Vercel Blob store to the project
# BLOB_READ_WRITE_TOKEN=

# The live website address (for Google / sitemap), e.g. https://ahmad-hussain.vercel.app
NEXT_PUBLIC_SITE_URL=
